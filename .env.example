# Public Medusa backend and sales-channel key, required for live browsing/orders.
PUBLIC_VITE_BACKEND_URL=
PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Payment configuration. Use approved test values for development.
PUBLIC_POINT_OF_SALE_ID=
EPAY_API_KEY=

# Optional consent and analytics integrations.
PUBLIC_COOKIE_YES_ID=
PUBLIC_GA_MEASUREMENT_ID=

# Optional tasting-event integration (private).
UNDERSTORY_CLIENT_ID=
UNDERSTORY_CLIENT_SECRET=

# Cancellation-request email integration (private).
RESEND_API_KEY=
CANCELLATION_REQUEST_EMAIL_FROM=
# Set CANCELLATION_REQUEST_EMAIL_TO only to override the store-inbox default.

# Leave PURCHASES_PAUSED unset unless an explicit freeze setting is intended.
